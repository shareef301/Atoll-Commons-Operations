# Railway: attach one persistent volume at /data before the first deployment.
NODE_ENV=production
APP_URL=https://ops.atollcommons.org
DATA_DIR=/data
OWNER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Railway supplies PORT. Never put secrets in VITE_* or NEXT_PUBLIC_* variables.

# For local development, use .env.local with:
# APP_URL=http://localhost:3000
# DATA_DIR=.data
# AUTH_MODE=development
# OWNER_EMAIL=owner@example.test
# Do not set AUTH_MODE=development on Railway.
